  case when prompt_message_id is null then false when ( not exists (select 1 from chat_message m where m.conversation_id = tool_call.conversation_id and m.role = 'user' and m.id > tool_call.prompt_message_id)
and not exists (select 1 from chat_conversation c where c.id = tool_call.conversation_id and c.tool_selection_cutoff >= tool_call.prompt_message_id)
and not exists (select 1 from tool_call_stop s where s.conversation_id = tool_call.conversation_id and s.stopped_prompt_id >= tool_call.prompt_message_id)) then false else true end as superseded, parent_call_id,disclosure_confirmation from tool_call where id = ?]
