# Keplura server -- production image (DEPLOY-BUNDLE, t_bc138a04).
#
# Multi-stage: the Maven build runs INSIDE the first stage's container, so the
# build machine needs only a container runtime -- no JDK, no maven, no repo
# toolchain beyond the checkout. Stage 2 ships the fat jar on a JRE base.
#
# Build (from the repo root, or let compose.prod.yml do it):
#   docker build -f deploy/Dockerfile.server -t keplura-server:local .
# Run (standalone; compose.prod.yml wires DB + env for you):
#   docker run --rm -p 127.0.0.1:8080:8080 \
#     -e SPRING_PROFILES_ACTIVE=prod \
#     -e KEPLURA_DB_URL=... -e KEPLURA_DB_USER=... -e KEPLURA_DB_PASSWORD=*** \
#     -v keplura-storage:/var/lib/keplura \
#     keplura-server:local
#
# Tests are NOT run here -- the binding gate is `bash scripts/ci-local.sh` on
# real infra (AGENTS.md); the image build stays a pure package step.

# ---- web stage (ADR-0011 browser-first) -------------------------------------
# The Vue app is built once as a same-origin web bundle and shipped inside the
# server jar (classpath:/static) -- the browser opens https://<host>/ and talks
# to /api on the same origin. The Tauri desktop build is unaffected.
FROM node:22-bookworm-slim AS web
WORKDIR /web
COPY desktop/package.json desktop/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY desktop/ ./
RUN VITE_SERVER_URL=same-origin npx vite build

# ---- build stage ------------------------------------------------------------
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build
# copy the build definition first: docker layer cache survives source-only
# changes through the dependency resolution step.
COPY server/pom.xml server/pom.xml
# sibling-path stub keeps `mvn -f server/pom.xml` valid without the sources;
# parent resolution needs nothing else (spring-boot-starter-parent is remote).
RUN mvn -B -q -f server/pom.xml dependency:go-offline -DskipTests || true
COPY server/src server/src
COPY --from=web /web/dist server/src/main/resources/static
RUN mvn -B -q -f server/pom.xml package -DskipTests

# ---- FD-bound local source reader (read-only Linux helper) ---------------------
FROM rust:1.100-slim-bookworm AS local-reader-build
WORKDIR /reader
COPY server/native/local-reader/ ./
RUN cargo build --release --locked

# ---- runtime stage -----------------------------------------------------------
FROM eclipse-temurin:21-jre-noble
# curl only for the container HEALTHCHECK probe; tini as PID 1 so SIGTERM
# reaches the JVM cleanly (graceful shutdown, session drain).
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl tini acl \
      tesseract-ocr tesseract-ocr-deu tesseract-ocr-eng \
 && rm -rf /var/lib/apt/lists/*
# dedicated non-root user; uid 1000 is the documented owner of a bind-mounted
# /var/lib/keplura on the host (deploy/compose.prod.yml header).
# Ubuntu 24.04 (noble) ships a default `ubuntu` user on uid 1000 -- drop it
# so uid 1000 is ours (useradd otherwise fails with exit 4 "UID in use").
RUN if id -u ubuntu >/dev/null 2>&1; then userdel -r ubuntu; fi \
 && useradd --uid 1000 --create-home --shell /usr/sbin/nologin keplura \
 && mkdir -p /var/lib/keplura/uploads \
 && chown -R keplura:keplura /var/lib/keplura
WORKDIR /app
COPY --from=build /build/server/target/keplura-server-*.jar /app/keplura-server.jar
COPY --chmod=755 --from=local-reader-build /reader/target/release/keplura-local-reader /usr/local/bin/keplura-local-reader
USER keplura
ENV KEPLURA_UPLOAD_DIR=/var/lib/keplura/uploads
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8080/api/v1/health || exit 1
ENTRYPOINT ["/usr/bin/tini", "--", "java", "-jar", "/app/keplura-server.jar"]
