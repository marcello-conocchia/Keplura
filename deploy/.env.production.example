# Keplura production env template (deploy/compose.prod.yml).
#
# Copy to .env.production NEXT TO THIS FILE, replace every placeholder with a
# real value, keep the file out of git (.gitignore rule `deploy/.env.production`) and
# out of logs, PRs and chat alike. NEVER put a real credential into a committed
# file. All placeholders below are pure ASCII on purpose (M3a rule) so copying
# them cannot smuggle invisible characters into credentials.
#
# Usage:
#   docker compose -f compose.prod.yml --env-file .env.production up -d --build
#
# Variables consumed ONLY by the server process (never by containers directly)
# are still listed here because compose.prod.yml forwards them.

# ---------------------------------------------------------------------------
# 1) Database (mandatory -- compose fails fast without these)
# ---------------------------------------------------------------------------
POSTGRES_DB=keplura
POSTGRES_USER=keplura
# Generate: openssl rand -hex 24   (no shell metacharacters, no '@' or ':')
POSTGRES_PASSWORD=***

# ---------------------------------------------------------------------------
# 2) Server (defaults are fine for the stack; override deliberately)
# ---------------------------------------------------------------------------
# Port published on 127.0.0.1 of the host (the reverse proxy's upstream).
# Change only on port conflicts; the compose port mapping stays loopback-only.
KEPLURA_SERVER_HOST_PORT=8080

# Per-document upload cap in bytes (default 20 MiB = 20971520). Applies to
# upload AND read paths; raising it raises parser/memory budgets too.
KEPLURA_UPLOAD_MAX_BYTES=20971520

# ---------------------------------------------------------------------------
# 3) Model provider (M4c presets) -- exactly ONE block, others stay commented
# ---------------------------------------------------------------------------
KEPLURA_PROVIDER=ollama

# A) ollama (default): bundled in compose.prod.yml, no API key. The
#    ollama-pull job downloads this model automatically before the server starts:
KEPLURA_GATEWAY_BASE_URL=http://ollama:11434/v1
# Small boxes (no GPU, <16 GB RAM): qwen2.5:3b; tiny test boxes: qwen2.5:0.5b
KEPLURA_CHAT_MODEL=qwen2.5:7b

# B) vllm: GPU inference server (hardware is owner-side; run it where the card
#    lives -- NOT necessarily on this compose host).
# KEPLURA_PROVIDER=vllm
# KEPLURA_GATEWAY_BASE_URL=http://gpu-server.internal:8000/v1
# Must match the served model name on that box:
# KEPLURA_CHAT_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# C) Hosted OpenAI-compatible API (real spend -- PO decision; key is ENV-only,
#    never committed, never logged):
# KEPLURA_PROVIDER=api
# KEPLURA_GATEWAY_BASE_URL=https://api.openai.com/v1
# KEPLURA_GATEWAY_API_KEY=***
# Pin which models the shared key may serve (recommended when paying):
# KEPLURA_GATEWAY_ALLOWED_MODELS=gpt-4o-mini
# KEPLURA_CHAT_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# 4) Embeddings (search / RAG). Default: multilingual bge-m3 via the bundled
#    Ollama (pulled automatically). The pgvector column follows the dimension
#    automatically while NO document is indexed yet (ADR-0010); changing the
#    model later needs a re-index. "local" = hash fallback, NOT semantic.
# ---------------------------------------------------------------------------
KEPLURA_EMBEDDING_BACKEND=gateway
KEPLURA_EMBEDDING_BASE_URL=http://ollama:11434/v1
KEPLURA_EMBEDDING_MODEL=bge-m3
# Must equal the model's real output dimension (bge-m3 = 1024):
KEPLURA_EMBEDDING_DIM=1024
# Local cross-encoder (Compose starts TEI; no document text leaves the host).
# An empty URL disables reranking only for an explicit bare-metal/dev setup.
KEPLURA_RERANKER_URL=http://reranker:80/rerank
KEPLURA_RERANKER_MIN_SCORE=0.5
KEPLURA_RERANKER_TIMEOUT_SECONDS=60
# KEPLURA_EMBEDDING_API_KEY=***
# Air-gapped host with a pre-filled ollamamodels volume:
# KEPLURA_SKIP_MODEL_PULL=1
# ---------------------------------------------------------------------------
# 5) Advanced overrides (leave commented for a standard deployment)
# ---------------------------------------------------------------------------
# Fail the boot instead of falling back to in-JVM cosine search when pgvector
# is unavailable (default auto):
# KEPLURA_SEARCH_STORE=pgvector
# Datasource escape hatch for air-gapped image rebuilds (JDBC driver class):
# KEPLURA_DB_DRIVER=org.postgresql.Driver
# Use a pre-built server image instead of building from source (skips git on
# the deployment host entirely):
# KEPLURA_SERVER_IMAGE=registry.internal/keplura-server:0.1.0

# ---------------------------------------------------------------------------
# 6) ADMIN-KI (docs/adr/0008) -- in-UI upkeep for KI providers/models
# ---------------------------------------------------------------------------
# AES-GCM master key that encrypts provider API keys at rest. Generate:
#   openssl rand -base64 32
# WITHOUT it the admin panel stays fully usable but storing a provider secret
# there answers 503 MASTER_KEY_MISSING (the ENV gateway key above keeps
# working through the fallback) -- set it before storing the first key.
# KEPLURA_SECRETS_MASTER_KEY=

# First-boot admin account (AdminBootstrapRunner): BOTH values required.
# Idempotent across restarts and NEVER resets an existing password -- an
# existing account only gets the ADMIN role raised. Recommended: set for the
# first boot, then remove both lines (the DB role survives).
# KEPLURA_ADMIN_BOOTSTRAP_EMAIL=admin@company.internal
# KEPLURA_ADMIN_BOOTSTRAP_PASSWORD=***
# Extra IPv4 CIDRs for the SSRF-guarded connection tests. Posture is DEFAULT
# CLOSED (docs/adr/0008 §7.2): loopback, RFC1918, CGNAT 100.64.0.0/10,
# link-local/metadata, IPv6 ULA fc00::/7, multicast are ALL refused out of
# the box; only public routes dial freely. Ops opens a target by naming its
# CIDR here. Single-host Ollama with a green connection test needs:
# KEPLURA_ADMIN_SSRF_ALLOW_CIDRS=127.0.0.0/8
# e.g. a vLLM box on a LAN subnet:
# KEPLURA_ADMIN_SSRF_ALLOW_CIDRS=10.99.0.0/16

# ---------------------------------------------------------------------------
# 7) Tuning surface (RELEASE-GATE-1 diff vs application*.properties) -- all
#    remaining ENV hooks the server reads. Defaults are the app-internal ones
#    (shown); touch only with a reason. NOTE: compose.prod.yml does NOT
#    forward these into the server container; they apply to the bare-metal /
#    `java -jar` shape unless you extend the compose `environment:` block.
# ---------------------------------------------------------------------------
# Storage/datasource escape hatches (see section 1; the compose shape wires
# these itself from the POSTGRES_* values):
# KEPLURA_DB_URL=jdbc:postgresql://localhost:5432/keplura
# KEPLURA_DB_USER=keplura
# KEPLURA_DB_PASSWORD=***
# KEPLURA_DB_DDL_AUTO=validate
# KEPLURA_SERVER_PORT=8080
# Document storage tree (compose shape sets this to /var/lib/keplura/uploads):
# KEPLURA_UPLOAD_DIR=./data/uploads
# Chunking + search budgets:
# KEPLURA_CHUNK_SIZE_CHARS=800
# KEPLURA_CHUNK_OVERLAP_CHARS=100
# KEPLURA_MAX_QUERY_CHARS=4000
# KEPLURA_EMBEDDING_TIMEOUT_SECONDS=30
# Document parser budgets:
# KEPLURA_PARSER_MAX_CHARS=2000000
# KEPLURA_PARSER_PDF_MAX_PAGES=500
# KEPLURA_PARSER_DOCX_MAX_PAGES=200
# KEPLURA_PARSER_MAX_ENTRY_COUNT=5000
# KEPLURA_PARSER_TIMEOUT_SECONDS=60
# KEPLURA_PARSER_CONCURRENCY=2
# Gateway request/response/stream budgets:
# KEPLURA_GATEWAY_TIMEOUT_SECONDS=30
# KEPLURA_GATEWAY_STREAM_IDLE_SECONDS=60
# KEPLURA_GATEWAY_STREAM_DEADLINE_SECONDS=300
# KEPLURA_GATEWAY_MAX_REQUEST_BYTES=1048576
# KEPLURA_GATEWAY_MAX_RESPONSE_BYTES=8388608
# KEPLURA_GATEWAY_MAX_MESSAGE_CHARS=65536
# KEPLURA_GATEWAY_MAX_MESSAGES=256
# Chat context budgets:
# KEPLURA_CHAT_CONTEXT_MESSAGES=20
# KEPLURA_CHAT_RAG_TOP_K=4
# KEPLURA_CHAT_MAX_PROMPT_CHARS=4000
# KEPLURA_CHAT_CONTEXT_CHUNK_CHARS=700
# KEPLURA_CHAT_MAX_TOKENS=0
