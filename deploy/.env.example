# Copy to .env (git-ignored) and fill in local values. NEVER commit real
# credentials; keep them out of git, logs, PRs and chat alike.
# Used by deploy/docker-compose.yml (database container) and by the server
# via environment variables when starting it against PostgreSQL.

POSTGRES_DB=keplura
POSTGRES_USER=keplura
POSTGRES_PASSWORD=change-me-before-use
# Host port the container publishes 5432 on (5432 if free):
POSTGRES_HOST_PORT=5432

# JDBC settings for `SPRING_PROFILES_ACTIVE=prod java -jar ...` against the
# compose stack (see docs/development.md, "Server mit Postgres starten"):
KEPLURA_DB_URL=jdbc:postgresql://localhost:5432/keplura
KEPLURA_DB_USER=keplura
KEPLURA_DB_PASSWORD=change-me-before-use

# --------------------------------------------------------------------------
# M4c model providers - exactly ONE preset is active at a time (PO decision
# 06.09.: A Ollama local, B vLLM GPU server, C hosted OpenAI-compatible API).
# All values below are PLACEHOLDERS; real keys stay out of this file, of git,
# of logs and of chat alike (M3a rule). Switching = change KEPLURA_PROVIDER
# (+ the model name if non-default) and restart the SERVER process; the
# desktop never sees any of it (SSE + tenant gates stay identical).
# --------------------------------------------------------------------------

# A) Ollama (local box, no GPU, no key):
#      docker compose --profile ollama up -d ollama
#      docker compose exec ollama ollama pull qwen2.5:0.5b
KEPLURA_PROVIDER=ollama
# Base URL only needed when Ollama does NOT listen at the default port:
#KEPLURA_GATEWAY_BASE_URL=http://127.0.0.1:11434/v1
# Model must name a pulled tag; default when unset: qwen2.5:0.5b
#KEPLURA_CHAT_MODEL=qwen2.5:0.5b

# B) vLLM (GPU server - hardware is PO-side, not a repo deliverable):
#      docker compose --profile vllm up -d vllm   (on the GPU box)
#KEPLURA_PROVIDER=vllm
#KEPLURA_GATEWAY_BASE_URL=http://gpu-server.internal:8000/v1
# Must match the served model (vLLM --served-model-name / --model):
#KEPLURA_CHAT_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# C) Hosted OpenAI-compatible API (NO real paid calls in this repo's tests;
#    key usage is a PO decision):
#KEPLURA_PROVIDER=api
#KEPLURA_GATEWAY_BASE_URL=https://api.openai.com/v1
# SERVER-SIDE ONLY ENV - never in a committed file, never sent to the desktop:
#KEPLURA_GATEWAY_API_KEY=replac...here
#KEPLURA_CHAT_MODEL=gpt-4o-mini
# Pin which models the shared key may serve (recommended for real spend):
#KEPLURA_GATEWAY_ALLOWED_MODELS=gpt-4o-mini
