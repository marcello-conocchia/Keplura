# Keplura — configuration example for LOCAL DEVELOPMENT and evaluation.
#
# Every value below is a harmless placeholder. Copy what you need into your
# shell environment or an untracked `.env` file — never commit real values.
# `.env`, `.env.local` and `deploy/.env.production` are git-ignored.
#
# Production installations use deploy/.env.production, created by
# deploy/install.sh from deploy/.env.production.example. That file documents
# every production setting; this one lists the ones a developer typically
# touches. Spring Boot reads the variables when the server starts.

# --- Server profile -----------------------------------------------------------
# dev (default): H2 file database, schema auto-update, optional seeded account.
# prod: PostgreSQL + Flyway migrations, Secure session cookie (needs HTTPS or
# localhost).
SPRING_PROFILES_ACTIVE=dev
KEPLURA_SERVER_PORT=8080

# --- Database (prod profile, or dev against PostgreSQL) ---------------------
# Local PostgreSQL + pgvector: `cd deploy && cp .env.example .env &&
# docker compose up -d db` (see docs/development.md).
KEPLURA_DB_URL=jdbc:postgresql://localhost:5432/keplura
KEPLURA_DB_USER=keplura
KEPLURA_DB_PASSWORD=change-me-local-only

# --- Secrets -----------------------------------------------------------------
# Encrypts provider / data-source credentials stored by admins. Generate your
# own (e.g. `openssl rand -base64 32`); losing it makes stored secrets
# unreadable. Leave empty in development to disable stored secrets.
KEPLURA_SECRETS_MASTER_KEY=

# First admin account, applied idempotently at startup (never resets an
# existing password). Use an address you control; example.com is reserved.
KEPLURA_ADMIN_BOOTSTRAP_EMAIL=admin@example.com
KEPLURA_ADMIN_BOOTSTRAP_PASSWORD=change-me-local-only

# --- Model provider ----------------------------------------------------------
# One preset: ollama | vllm | api. Empty = no model (chat cannot answer).
KEPLURA_PROVIDER=ollama
# Only needed when the provider does not listen at its default address.
#KEPLURA_GATEWAY_BASE_URL=http://127.0.0.1:11434/v1
#KEPLURA_CHAT_MODEL=qwen2.5:7b
# Hosted OpenAI-compatible API only. Server-side; never sent to clients.
#KEPLURA_GATEWAY_API_KEY=your-api-key-here
#KEPLURA_GATEWAY_ALLOWED_MODELS=gpt-4o-mini

# --- Embeddings and search ---------------------------------------------------
# local = built-in hash embeddings (no model needed, weak quality, fine for
# development); gateway = real embedding model via an OpenAI-compatible API.
KEPLURA_EMBEDDING_BACKEND=local
#KEPLURA_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
#KEPLURA_EMBEDDING_MODEL=bge-m3
#KEPLURA_EMBEDDING_DIM=1024
#KEPLURA_RERANKER_URL=http://127.0.0.1:8081/rerank

# --- Documents ----------------------------------------------------------------
KEPLURA_UPLOAD_DIR=./data/uploads
KEPLURA_UPLOAD_MAX_BYTES=20971520
# OCR for scanned PDFs needs `tesseract` with German/English language packs.
KEPLURA_OCR_ENABLED=false

# --- Outbound connections -----------------------------------------------------
# Private networks are blocked for model endpoints, web search and MCP (SSRF
# protection). Allow specific internal ranges only when you need them.
#KEPLURA_ADMIN_SSRF_ALLOW_CIDRS=10.99.0.0/16
KEPLURA_WEBSEARCH_PROVIDER=none

# --- Desktop / web UI (read by Vite at build time, see desktop/.env) ---------
VITE_SERVER_URL=http://localhost:8080
